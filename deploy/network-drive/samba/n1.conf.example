[global]
server min protocol = SMB2
server max protocol = SMB3
map to guest = Never

[n1_fragment_example]
path = /srv/n1fs/<fragment_hash>
browseable = yes
read only = no
guest ok = no
valid users = <smb_user>
force user = <n1_user>
force group = <n1_group>
create mask = 0664
directory mask = 0775
vfs objects = acl_xattr
map acl inherit = yes
store dos attributes = yes
