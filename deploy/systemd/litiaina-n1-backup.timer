[Unit]
Description=Litiaina N1 optional scheduled maintenance-window backup

[Timer]
OnCalendar=Sun *-*-* 02:00:00
AccuracySec=1min
RandomizedDelaySec=0
# Missed downtime windows must not trigger an unexpected backup at boot.
Persistent=false
Unit=litiaina-n1-backup.service

[Install]
WantedBy=timers.target
Also=litiaina-n1-backup-recover.service
