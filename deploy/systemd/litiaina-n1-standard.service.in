[Unit]
Description=Litiaina N1 Standard
Wants=network-online.target
After=network-online.target local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=10
AssertPathExists=__WORKING_DIRECTORY__
AssertFileIsExecutable=__BINARY__
AssertPathExists=__ENV_FILE__
AssertPathExists=__CONFIG_FILE__

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
__PRIVILEGE_LINES__

WorkingDirectory=__WORKING_DIRECTORY__
EnvironmentFile=__ENV_FILE__
Environment=RUST_LOG=__RUST_LOG__
Environment=RUST_BACKTRACE=1
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
Environment=N1_XFS_QUOTA_BIN=__XFS_QUOTA_BIN__

ExecStart=__BINARY__

Restart=on-failure
RestartSec=3

KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=5min
TimeoutStartSec=60

LimitNOFILE=1048576
LimitCORE=infinity
TasksMax=infinity
LimitMEMLOCK=infinity

OOMScoreAdjust=-900
OOMPolicy=stop
Nice=-5
UMask=0027

SyslogIdentifier=__SERVICE_NAME__
StandardOutput=journal
StandardError=journal

PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
