# Litiaina N1 Standard production environment.
# Copy to <install-dir>/n1.env and replace every secret before installing.

# Secret key used for signing JWT tokens.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Default access-token TTL in seconds.
ACCESS_TOKEN_DEFAULT_TTL_SECS=900

# Maximum access-token TTL in seconds even if clients request more.
ACCESS_TOKEN_MAX_TTL_SECS=3600

# Refresh-token TTL in seconds.
REFRESH_TOKEN_TTL_SECS=604800

# Storage authentication key.
AUTH_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Server/master administration key.
MASTER_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Admin access key.
ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional: move refresh session state out of fs_storage_path.
# N1_REFRESH_STORE_ROOT=/var/lib/litiaina-n1/refresh_sessions
