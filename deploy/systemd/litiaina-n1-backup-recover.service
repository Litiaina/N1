[Unit]
Description=Recover N1 restart intent after interrupted automatic backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=litiaina/n1-backup
StateDirectoryMode=0700
ExecStart=/opt/litiaina/n1/litiaina-n1-shell backup recover-job --state-dir /var/lib/litiaina/n1-backup
TimeoutStartSec=360
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
